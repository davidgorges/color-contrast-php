{
    "name": "davidgorges/color-contrast-php",
    "description": "A tiny library to find color combinations with a contrast threshold",
    "type": "library",
    "keywords": ["color", "contrast", "library", "WCAG 2.0", "usability"],
    "homepage": "http://www.davidgorges.de",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-strict-rules": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "ColorContrast\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ColorContrast\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpcs": "phpcs",
        "phpstan": "phpstan analyse",
        "check": [
            "@phpcs",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    }
}
